{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
  "type": "file",
  "source": "~/.config/fastfetch/icon/miku.txt",
  "color": {
    "1": "\u001b[38;5;147m"
  }
},
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "key": "\u001b[38;5;147m╭──────────╮",
      "type": "custom"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} USER   │",
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} DATE   │",
      "type": "datetime",
      "format": "{day-pretty}/{month-pretty}/{year} - {hour-pretty}:{minute-pretty}:{second-pretty} {timezone-name}"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} UPTIME │",
      "type": "uptime"
    },
    {
      "key": "\u001b[38;5;147m╰──────────╯",
      "type": "custom"
    },
    {
      "key": "\u001b[38;5;147m╭──────────╮",
      "type": "custom"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} DISTRO │",
      "type": "os"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} KERNEL │",
      "type": "kernel"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} OS AGE │",
      "type": "command",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
    },
    {
      "key": "\u001b[38;5;147m╰──────────╯",
      "type": "custom"
    },
    {
      "key": "\u001b[38;5;147m╭──────────╮",
      "type": "custom"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} CPU    │",
      "type": "cpu",
      "format": "{name} ({cores-physical}C/{cores-logical}T @ {freq-max})"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} GPU    │",
      "type": "gpu"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} RAM    │",
      "type": "memory"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} SSD    │",
      "type": "disk",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "folders": "/"
    },
    {
      "key": "\u001b[38;5;147m│ {icon} HDD    │",
      "type": "disk",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "folders": "/mnt/HDD"
    },
    {
      "key": "\u001b[38;5;147m╰──────────╯",
      "type": "custom"
    },
    {
      "key": "\u001b[38;5;147m╭──────────╮",
      "type": "custom"
    },
    {
      "key": "\u001b[38;5;147m│  COLORS │",
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m " 
    },
    {
      "key": "\u001b[38;5;147m╰──────────╯",
      "type": "custom"
    }
  ]
}
