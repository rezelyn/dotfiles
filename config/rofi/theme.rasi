* {
    rosewater: #f5e0dc;
    flamingo: #f2cdcd;
    pink: #f5c2e7;
    mauve: #cba6f7;
    red: #f38ba8;
    maroon: #eba0ac;
    peach: #fab387;
    yellow: #f9e2af;
    green: #a6e3a1;
    teal: #94e2d5;
    sky: #89dceb;
    sapphire: #74c7ec;
    blue: #89b4fa;
    lavender: #b4befe;
    text: #cdd6f4;
    subtext1: #bac2de;
    subtext0: #a6adc8;
    overlay2: #9399b2;
    overlay1: #7f849c;
    overlay0: #6c7086;
    surface2: #585b70;
    surface1: #45475a;
    surface0: #313244;
    base: #1e1e2e;
    mantle: #181825;
    crust: #11111b;
    
    background-color: transparent;
    text-color: @text;
    accent: @mauve;
    urgent: @red;
    on-accent: @crust;
}

window {
    background-color: rgba(30, 30, 46, 0.5);
    border-color: @mauve;
    border: 2px;
    border-radius: 14px;
    padding: 0px;
    height: 500px;
    width: 800px;
    x-offset: 0;
    y-offset: 0;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    padding: 16px;
    spacing: 12px;
}

inputbar {
    background-color: rgba(30, 30, 46, 0.75);
    border-radius: 12px;
    padding: 6px 6px 6px 14px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    background-color: @mauve;
    text-color: @crust;
    font: "JetBrainsMono Nerd Font Bold 12";
    vertical-align: 0.5;
    padding: 4px 12px;
    border-radius: 8px;
}

entry {
    background-color: transparent;
    text-color: @text;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    columns: 2;
    lines: 12;
    spacing: 4px;
    padding: 12px;
    fixed-height: false;
    scrollbar: false;
    dynamic: true;
}

element {
    background-color: transparent;
    border-radius: 10px;
    padding: 8px 10px;
    spacing: 10px;
    orientation: horizontal;
    children: [ element-icon, element-text ];
}

element selected {
    background-color: rgba(203, 166, 247, 0.5);
    text-color: @mauve;
}

element-icon {
    background-color: transparent;
    size: 32px;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: @text;
    vertical-align: 0.5;
    highlight: bold;
}

scrollbar {
    handle-color: @surface1;
    handle-width: 4px;
    border-radius: 12px;
    background-color: transparent;
}

message {
    background-color: @surface0;
    border-radius: 10px;
    padding: 8px 14px;
}

textbox {
    background-color: transparent;
    text-color: @yellow;
}
